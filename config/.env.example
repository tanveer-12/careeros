# Copy this file to config/.env and fill in your values.
# Never commit config/.env — it is gitignored.
#
# Groq is free during development. Get a key at https://console.groq.com
# OpenAI is only required in Phase 4 (embeddings). Leave blank until then.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/careeros

# ── LLM — Groq (free, primary) ────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# ── LLM — OpenAI (Phase 4 embeddings only) ────────────────────────────────────
OPENAI_API_KEY=sk_your_key_here

# ── LLM runtime ───────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# ── Pipeline tuning ───────────────────────────────────────────────────────────
FRESHNESS_WINDOW_HOURS=24
SLUGS_PER_ATS=500
